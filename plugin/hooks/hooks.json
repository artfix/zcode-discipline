{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/backup.py", "session-start",
                     "--keep", "${user_config.backupKeep}",
                     "--max-source-mb", "${user_config.backupMaxMB}"],
            "timeoutMs": 60000,
            "statusMessage": "discipline: backing up session DB"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/loop_cap.py", "prompt",
                     "--max-rounds", "${user_config.maxRounds}",
                     "--warn-at", "${user_config.warnAt}"],
            "timeoutMs": 10000,
            "statusMessage": "discipline: counting round"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/loop_cap.py", "pretool",
                     "--max-rounds", "${user_config.maxRounds}",
                     "--warn-at", "${user_config.warnAt}"],
            "timeoutMs": 10000,
            "statusMessage": "discipline: checking loop cap"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/verify.py", "posttool",
                     "--stop-gate", "${user_config.stopGate}",
                     "--verify-command", "${user_config.verifyCommand}"],
            "timeoutMs": 15000,
            "statusMessage": "discipline: verifying edit landed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/verify.py", "stop",
                     "--stop-gate", "${user_config.stopGate}",
                     "--verify-command", "${user_config.verifyCommand}"],
            "timeoutMs": 60000,
            "statusMessage": "discipline: checking verification proof"
          }
        ]
      }
    ]
  }
}
